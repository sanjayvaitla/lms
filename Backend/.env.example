# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: postgresql://postgres:yourpassword@localhost:5432/vtricks_lms
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/vtricks_lms

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_secret_min_32_chars
# Access token lifetime (90m = 1.5 hours). Refresh tokens last JWT_REFRESH_EXPIRY (default 7d).
JWT_ACCESS_EXPIRY=90m
JWT_REFRESH_EXPIRY=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=6000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── AWS S3 (REQUIRED in production — all files live here, never on API disk) ─
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional CloudFront / custom domain (prefer private bucket + getUrl for files):
# AWS_S3_CUSTOM_DOMAIN=https://cdn.example.com
# Set true only for MinIO / LocalStack:
# AWS_S3_PATH_STYLE=true
# Dev-only escape hatch (NEVER in production):
# ALLOW_LOCAL_STORAGE=true

# ─── Judge0 (coding tests) ──────────────────────────────────────────────────
# Option A (recommended for production): RapidAPI Judge0 CE
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=your_rapidapi_key
# Option B: self-hosted / public CE (no RapidAPI key)
#   JUDGE0_URL=https://ce.judge0.com
#
# Without a working Judge0:
#   - Development: Python/JS run automatically on a local timeout-bounded runner
#   - Production: set ALLOW_LOCAL_CODE_EXEC=true to allow the same (prefer Judge0)
JUDGE0_URL=
JUDGE0_API_KEY=
# ALLOW_LOCAL_CODE_EXEC=true

# ─── Google OAuth — leave blank to disable ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6000/api/v1/auth/google/callback
CLIENT_URL=http://localhost:5173

# ─── MSG91 OTP — leave blank to disable ──────────────────────────────────────
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=10

# ─── Groq AI Grader — leave blank to disable AI grading ─────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ─── Seed admin password ──────────────────────────────────────────────────────
SEED_PASSWORD=Admin@123

# ─── WhatsApp Business Cloud API — leave blank to disable ────────────────────
# Required in production when WHATSAPP_ACCESS_TOKEN is set
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved Meta templates used by the LMS (must exist & be APPROVED, language en):
#   vtricks_assign_release   — assignment published ({{1}} name {{2}} title {{3}} course {{4}} due {{5}} marks)
#   vtricks_assign_result    — graded (name, title, course, score, max, date, feedback)
#   vtricks_assign_reminder  — due soon (name, title, course, deadline, days)
#   vtricks_inst1_confirm / vtricks_inst2_confirm / vtricks_inst_final — fee payments
#   vtricks_session_done     — session marked Done (name, sessionLabel, title, course, date)
#   vtricks_quiz_release     — quiz unlocked (name, quizTitle, sessionLabel, course)
#   vtricks_fee_reminder     — monthly fee dues (name, count, amount, course)
#   vtricks_weekly_assign    — weekly pending assignments (name, count)
# Webhook URL to register in Meta: https://YOUR_API_HOST/webhook/whatsapp
# NOTE: Free-form text only works within 24h of the student messaging you.
#        All proactive LMS alerts use templates above.

# ─── GitHub OAuth (login) — optional ─────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:6000/api/v1/auth/github/callback

# ─── GitHub Auto-Evaluation Pipeline ─────────────────────────────────────────
# Personal Access Token (PAT) with scopes: repo, admin:repo_hook
# Used to: (1) register webhooks on student fork repos, (2) fetch private repo code for AI grading
GITHUB_TOKEN=

# Secret token shared between GitHub webhook and this server for HMAC-SHA256 signature verification
# Generate with: openssl rand -hex 32  (or PowerShell RNG — see docs)
# Also used as GITHUB_WEBHOOK_SECRET fallback for /webhooks/github route
INTERN_WEBHOOK_SECRET=

# Public HTTPS URL of this backend — GitHub needs to reach it to send webhook events
# Example: https://api.yourcompany.com  (must be HTTPS for production)
SERVER_PUBLIC_URL=https://api.yourcompany.com

# ─── Placement Webhook ─────────────────────────────────────────────────────────
PLACEMENT_WEBHOOK_SECRET=

# ─── Email / SMTP — leave blank to disable email sending ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Vtricks LMS
SMTP_FROM_EMAIL=
